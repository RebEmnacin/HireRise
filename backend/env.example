# Copy this file to .env and edit.

# Leave as is to use a local SQLite file (zero setup).
# For Postgres paste your connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./hr.db

# REQUIRED. The app refuses to start without it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5173

# The first admin account. It is created on startup ONLY when the users table is empty.
FIRST_ADMIN_EMAIL=admin@hirerise.example
FIRST_ADMIN_PASSWORD=change-me-now
